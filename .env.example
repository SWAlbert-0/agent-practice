# 复制本文件为 .env，再填写自己的密钥；不要提交真实密钥。
# core/llm.py 通过 models.json 选择服务商和模型。

# DeepSeek：使用 models.json 中的 deepseek 配置时填写
DEEPSEEK_API_KEY=

# ModelScope：使用 models.json 中的 modelscope 配置时填写
MODELSCOPE_API_KEY=

# 兼容直接使用 HelloAgentsLLM 的示例，按需要填写
# 通过 create_llm() 调用时，云端密钥使用上面的专属变量。
LLM_API_KEY=

# Ollama 使用 models.json 中的本地地址和占位密钥，无需在这里填写。
